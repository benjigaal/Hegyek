<Window x:Class="hegyekWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:hegyekWPF"
        mc:Ignorable="d"
        Title="HegyekWPF" Height="450" Width="800">
    <Grid>
        <DataGrid x:Name="DataGrid1" HorizontalAlignment="Left" Height="414" Margin="10,0,0,0" VerticalAlignment="Center" Width="512" d:ItemsSource="{d:SampleData ItemCount=5}" SelectionChanged="DataGrid_SelectionChanged"/>
        <Label Content="Név:" HorizontalAlignment="Left" Height="29" Margin="539,26,0,0" VerticalAlignment="Top" Width="75"/>
        <Label Content="Hegység:" HorizontalAlignment="Left" Height="26" Margin="539,77,0,0" VerticalAlignment="Top" Width="75"/>
        <Label Content="Magasság:" HorizontalAlignment="Left" Height="27" Margin="539,130,0,0" VerticalAlignment="Top" Width="75"/>
        <TextBox x:Name="TextBox1" HorizontalAlignment="Left" Height="29" Margin="642,26,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="137"/>
        <TextBox x:Name="TextBox2" HorizontalAlignment="Left" Height="26" Margin="642,77,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="137"/>
        <TextBox x:Name="TextBox3" HorizontalAlignment="Left" Height="27" Margin="642,130,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="137"/>
        <Button x:Name="AddButton" Content="Hozzáad" HorizontalAlignment="Left" Height="26" Margin="576,191,0,0" VerticalAlignment="Top" Width="181" Click="AddButton_Click"/>
        <Button x:Name="SaveButton" Content="Mentés" HorizontalAlignment="Left" Height="27" Margin="576,253,0,0" VerticalAlignment="Top" Width="181" Click="SaveButton_Click"/>

    </Grid>
</Window>
